        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Adoption rate",
      "description": "Eligible projects with an observed terminal attempt / current eligible projects. Not proof of inactivity when delivery was missing.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "qaas-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "qaas_kpi_adoption_ratio{job=\"qaas_kpi\",window=\"$window\",team=\"$team\",environment=\"$environment\"}",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "qaas-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "N/A",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
