  "version": 1,
  "timezone": "utc",
  "editable": true,
  "timepicker": {
    "hidden": true
  },
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "tags": [
    "qaas",
    "prototype",
    "synthetic"
  ],
  "panels": [
    {
      "type": "row",
